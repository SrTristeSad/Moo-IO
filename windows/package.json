{
  "name": "moo-io",
  "private": true,
  "version": "0.1.0",
  "description": "Moo IO community LAN multiplayer",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:server": "npm install --prefix server --no-audit --no-fund",
    "start:server": "node server/src/index.js",
    "test": "node --test tests/*.test.mjs",
    "assets:check": "node tools/verify-bundled-art.mjs",
    "bundle:server": "node tools/build-offline-server.mjs"
  },
  "dependencies": {
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
